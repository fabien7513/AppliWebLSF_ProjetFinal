model Address {
  id_address Int @id @default(autoincrement())

  street     String
  city       String
  postalCode String @db.VarChar(10)
  latitude   Float?
  longitude  Float?

  id_user Int  @unique
  user    User @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
}

model Availability {
  id_availability Int @id @default(autoincrement())

  startDateTime DateTime
  endDateTime   DateTime

  interventionType String?
  comment          String?
  location         String?

  userId Int
  user   User @relation(fields: [userId], references: [id_user])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id_demande Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location      String
  startDateTime DateTime
  endDateTime   DateTime

  interventionType String?
  message          String?

  status EventStatus @default(PENDING)

  clientFirstName String?
  clientLastName  String?
  clientEmail     String?
  clientPhone     String?
  interpreterId   Int

  interpreter User @relation("InterpreterEvents", fields: [interpreterId], references: [id_user], onDelete: Cascade)
}

enum EventStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

model InterventionZone {
  id_zone Int @id @default(autoincrement())

  department Int
  city       String?
  postalCode String? @db.VarChar(10)
  radiusKm   Int

  userId Int
  user   User @relation(fields: [userId], references: [id_user])
}

model User {
  id_user   Int      @id @default(autoincrement())
  lastName  String   @db.VarChar(50)
  firstName String   @db.VarChar(50)
  mail      String   @unique
  role      UserRole @default(INTERPRETER)

  description String?
  photo       String?

  password String

  phone       String? @db.VarChar(20)
  siretNumber String? @unique @db.VarChar(14)

  profilStatus String?

  planning_public Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interventionZones InterventionZone[]
  availabilities    Availability[]

  interpreterEvents Event[] @relation("InterpreterEvents")

  address Address?
}

enum UserRole {
  CLIENT
  INTERPRETER
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}
