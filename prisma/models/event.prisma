model Event{
    id_demande Int @id @default(autoincrement())
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    location String
    startDateTime DateTime
    endDateTime DateTime

    interventionType String?
    message String?

    status EventStatus @default(PENDING)

    clientFirstName String?
    clientLastName String?
    clientEmail String?
    clientPhone String?
    interpreterId Int

    interpreter User @relation("InterpreterEvents", fields: [interpreterId], references: [id_user], onDelete: Cascade)


}

  enum EventStatus {
        PENDING
        ACCEPTED
        REFUSED
        CANCELLED
    }
