{% extends "../layout/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/static/assets/css/home.css">
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
{% endblock %}

{% block main %}

	<header class="home-header">
		<div class="header-top">
			<div class="logo">
				<img src="/static/assets/images/logo2.png" alt="Logo">
			</div>

			{% if user %}

				<div class="user-menu">

					<button id="user-btn" class="user-btn">
						Bonjour
						{{ user.firstName }}
						{{ user.lastName }}
						▾
					</button>

					<div id="user-dropdown" class="user-dropdown hidden">

						<a href="/profile">Mon profil</a>
						<a href="/reservations">Mes réservations</a>
						<a href="/scheduleinterpreters">Mon planning</a>
						<a href="/logout">Déconnexion</a>

					</div>

				</div>

			{% else %}

				<a href="/login" class="interpreter-btn">
					Vous êtes interprète ?
				</a>

			{% endif %}
		</div>

		<div class="header-center">
			<button id="open-modal" class="search-btn">
				🔎 Trouvez un interprète LSF en toute simplicité
			</button>

			<a href="/interpreters" class="show-btn">
				Afficher les interprètes
			</a>
		</div>
	</header>


	<main>
		<section class="intro-section">
			<div class="intro-container">

				<h2>Facilitez vos échanges avec un interprète LSF</h2>

				<p class="intro-text">
					Notre plateforme permet de trouver rapidement un interprète en Langue des Signes Française près de chez vous, pour tous vos besoins professionnels ou personnels.
				</p>

				<div class="intro-steps">

					<div class="step-card">
						<span class="step-number">1</span>
						<p>Recherchez un interprète selon votre lieu et vos besoins</p>
					</div>

					<div class="step-card">
						<span class="step-number">2</span>
						<p>Consultez les profils et disponibilités</p>
					</div>

					<div class="step-card">
						<span class="step-number">3</span>
						<p>Contactez et réservez facilement</p>
					</div>

				</div>

			</div>
		</section>

		<section class="map-section">
			<div class="map-container">
				<h2 class="map-title">📍 Localisez un interprète près de vous</h2>
				<p class="map-subtitle">
					Cliquez sur un point de la carte pour consulter le profil de l'interprète
				</p>

				<div class="map-wrapper">
					<div id="map"></div>
				</div>
			</div>
		</section>

		<section class="role-section">
			<div class="role-container">
				<h2>Le rôle d’une interprète LSF</h2>

				<ul class="role-list">
					<li>Traduction en temps réel</li>
					<li>Neutralité et confidentialité</li>
					<li>Communication accessible</li>
				</ul>
			</div>
		</section>

		<section class="services-section">
			<h2 class="services-title">Ce que nous proposons</h2>

			<div class="services-container">
				<div class="service-card">
					<img src="/static/assets/images/trad1.png" alt="Interprétation">
					<h3>Interprétation et déontologie</h3>
					<p>
						L’interprète a pour rôle de transmettre un discours d’une langue vers une autre. Respect du sens, neutralité et confidentialité.
					</p>
					<ul>
						<li>Secret professionnel</li>
						<li>Fidélité du message</li>
						<li>Neutralité</li>
					</ul>
				</div>

				<div class="service-card">
					<img src="/static/assets/images/trad2.png" alt="Domaines d'interventions">
					<h3>Domaines d'interventions</h3>
					<p>
						Nos interventions couvrent plusieurs domaines professionnels et institutionnels.
					</p>
					<ul>
						<li>Institutionnel</li>
						<li>Culturel</li>
						<li>Politique</li>
						<li>Santé</li>
						<li>Sport et loisirs</li>
					</ul>
				</div>

				<div class="service-card">
					<img src="/static/assets/images/trad3.png" alt="Éthique et expertise">
					<h3>Éthique et expertise</h3>
					<p>
						Tous nos interprètes sont diplômés et s'engagent à respecter une déontologie professionnelle stricte.
					</p>
				</div>
			</div>
		</section>

		<section class="about-section">
			<div class="about-container">
				<div class="about-logo">
					<img src="/static/assets/images/logo2.png" alt="Logo Réseau LSF">
				</div>

				<div class="about-text">
					<p>
						Réseau LSF Méditerranée facilite la mise en relation entre clients et interprètes en Langue des Signes Française.
					</p>

					<p>
						Les interprètes exercent en tant qu’indépendants et gèrent directement leurs interventions, disponibilités et modalités																																											          d’interventions.
					</p>
				</div>
			</div>
		</section>
	</main>


	<div id="search-modal" class="modal hidden">
		<div class="modal-box">
			<button id="close-modal" type="button">x</button>

			<h2 class="modal-title">Trouvez un interprète</h2>

			<form class="modal-form">
				<input type="text" placeholder="Lieu de votre rendez-vous">
				<input type="date">

				<label>Heure début</label>
				<input type="time" id="start-time">

				<label>Heure fin</label>
				<input type="time" id="end-time">

				<label>Durée</label>
				<input type="text" id="duration" readonly placeholder="Calcul automatique">

				<button type="submit" class="modal-submit">Rechercher</button>
			</form>
		</div>
	</div>

	<div id="interpreter-modal" class="interpreter-modal hidden">
		<div class="interpreter-modal-box">
			<button id="close-interpreter-modal" type="button" class="interpreter-modal-close">×</button>

			<div class="interpreter-modal-content">
				<div class="interpreter-modal-photo">
					<img id="modal-photo" src="/static/assets/images/avatar.png" alt="Photo interprète">
				</div>

				<div class="interpreter-modal-info">
					<h3 id="modal-name">Nom Prénom</h3>
					<p id="modal-description">Description</p>
					<p>
						<strong>Ville :</strong>
						<span id="modal-city"></span>
					</p>
					<p>
						<strong>Téléphone :</strong>
						<span id="modal-phone"></span>
					</p>
					<p>
						<strong>Email :</strong>
						<span id="modal-mail"></span>
					</p>
					<p>
						<strong>SIRET :</strong>
						<span id="modal-siret"></span>
					</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		const interpreters = {{ interpreters|json_encode|raw }};
	</script>

	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
	<script src="/static/assets/js/home.js"></script>
{% endblock %}
