{% extends "../layout/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/static/assets/css/interpreters.css">
{% endblock %}


{% block main %}

	<header class="home-header">
		<div class="header-top">
			<a href="/">
				<img src="/static/assets/images/logo2.png" alt="Logo Réseau LSF">
			</a>

			<a href="/login" class="interpreter-btn">
				Vous êtes interprète ?
			</a>
		</div>

		<section class="search-interpreter-section">
			<div class="search-box">
				<h2>Recherche un interprète
					<span>🔎</span>
				</h2>

				<form class="search-form">
					<div class="form-row">
						<label for="department">Département :</label>
						<select id="department">
							<option value="13">13 - Bouches-du-Rhône</option>
							<option value="83">83 - Var</option>
						</select>
					</div>

					<div class="form-row">
						<label for="city">Ville :</label>
						<select id="city">
							<option>Choisissez une ville</option>
						</select>
					</div>

					<div class="form-row">
						<label for="availability">Disponibilité :</label>
						<select id="availability" name="availability">
							<option value="today">Aujourd'hui</option>
							<option value="tomorrow">Demain</option>
							<option value="week">Cette semaine</option>
						</select>
					</div>

					<div class="form-row">
						<label for="name">Nom :</label>
						<input id="name" type="text" name="name" placeholder="Nom (optionnel)">
					</div>

					<div class="form-button">
						<button type="submit">🔎 Trouvez un interprète</button>
					</div>
				</form>
			</div>
		</section>
	</header>


	<h1>Liste des interprètes</h1>

	<section class="interpreter-card-section">
  <div class="interpreters-grid">
    {% for interpreter in interpreters %}
      <div class="interpreter-card" data-interpreter="{{ interpreter|json_encode|raw }}">

        <div class="interpreter-image">
          <img src="{{ interpreter.photo ?? '/static/assets/images/avatar.png' }}" alt="Photo interprète">
        </div>

        <div class="interpreter-info">
          <h3>{{ interpreter.firstName }} {{ interpreter.lastName }}</h3>

          <p>{{ interpreter.description ?? 'Aucune description disponible' }}</p>
          <p><strong>Ville :</strong> {{ interpreter.address.city ?? 'Ville non spécifiée' }}</p>
          <p><strong>Téléphone :</strong> {{ interpreter.phone ?? 'Téléphone non spécifié' }}</p>
          <p><strong>Email :</strong> {{ interpreter.mail }}</p>
          <p><strong>N° SIRET :</strong> {{ interpreter.siretNumber }}</p>

          <a href="/schedule-interpreters" class="planning-btn">Planning</a>
        </div>

      </div>
    {% endfor %}
  </div>
</section>



	<script src="/static/assets/js/interpreters.js"></script>

{% endblock %}
