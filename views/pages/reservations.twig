{% extends "../layout/base.twig" %}

{% block style %}
  <link rel="stylesheet" href="/static/assets/css/reservations.css">
{% endblock %}

{% block title %}
  <title>Mes réservations</title>
{% endblock %}

{% block main %}

<main class="reservations-page">

  <section class="reservations-top">
    <a href="/" class="reservations-logo">
      <img src="/static/assets/images/logo2.png" alt="Logo Réseau LSF">
    </a>

    <h1>Mes réservations</h1>
  </section>

  <section class="reservations-section">
    <div class="reservations-container">

      <div class="reservation-card past-card">
        <h2>Historique</h2>

        <div class="reservation-list">
          {% if error %}
            <p class="empty-text">{{ error }}</p>
          {% elseif pastReservationGroups|length == 0 %}
            <p class="empty-text">Aucune réservation passée pour le moment.</p>
          {% else %}
            {% for monthGroup in pastReservationGroups %}
              <details class="reservation-month" {% if loop.first %}open{% endif %}>
                {% set count = monthGroup.reservations|length %}
                <summary>
                  <span class="reservation-month-title">{{ monthGroup.label }}</span>
                  <span class="reservation-month-meta">
                    <span class="reservation-month-hint">Cliquer pour afficher</span>
                    <span class="reservation-month-count">
                      {{ count }} rendez-vous
                    </span>
                  </span>
                </summary>
                <div class="reservation-month-list">
                  {% for reservation in monthGroup.reservations %}
                    <article class="reservation-item">
                      <h3>{{ reservation.title }}</h3>
                      <p><strong>{{ reservation.counterpartLabel }} :</strong> {{ reservation.counterpartName }}</p>
                      {% if reservation.counterpartEmail %}
                        <p><strong>Email :</strong> {{ reservation.counterpartEmail }}</p>
                      {% endif %}
                      {% if reservation.counterpartPhone %}
                        <p><strong>Téléphone :</strong> {{ reservation.counterpartPhone }}</p>
                      {% endif %}
                      <p>
                        <strong>Statut :</strong>
                        <span class="reservation-status reservation-status-{{ reservation.status|lower }}">
                          {{ reservation.statusLabel }}
                        </span>
                      </p>
                      <p><strong>Début :</strong> {{ reservation.startLabel }}</p>
                      <p><strong>Fin :</strong> {{ reservation.endLabel }}</p>
                      <p><strong>Lieu :</strong> {{ reservation.location }}</p>
                      {% if reservation.comment %}
                        <p><strong>Commentaire :</strong> {{ reservation.comment }}</p>
                      {% endif %}
                    </article>
                  {% endfor %}
                </div>
              </details>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <div class="reservation-card upcoming-card">
        <h2>À venir</h2>

        <div class="reservation-list">
          {% if error %}
            <p class="empty-text">{{ error }}</p>
          {% elseif upcomingReservations|length == 0 %}
            <p class="empty-text">Aucune réservation à venir pour le moment.</p>
          {% else %}
            {% for reservation in upcomingReservations %}
              <article class="reservation-item">
                <h3>{{ reservation.title }}</h3>
                <p><strong>{{ reservation.counterpartLabel }} :</strong> {{ reservation.counterpartName }}</p>
                {% if reservation.counterpartEmail %}
                  <p><strong>Email :</strong> {{ reservation.counterpartEmail }}</p>
                {% endif %}
                {% if reservation.counterpartPhone %}
                  <p><strong>Téléphone :</strong> {{ reservation.counterpartPhone }}</p>
                {% endif %}
                <p>
                  <strong>Statut :</strong>
                  <span class="reservation-status reservation-status-{{ reservation.status|lower }}">
                    {{ reservation.statusLabel }}
                  </span>
                </p>
                <p><strong>Début :</strong> {{ reservation.startLabel }}</p>
                <p><strong>Fin :</strong> {{ reservation.endLabel }}</p>
                <p><strong>Lieu :</strong> {{ reservation.location }}</p>
                {% if reservation.comment %}
                  <p><strong>Commentaire :</strong> {{ reservation.comment }}</p>
                {% endif %}
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>

    </div>
  </section>

</main>

{% endblock %}
