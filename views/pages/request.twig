{% extends "../layout/base.twig" %}

{% block style %}
  <link rel="stylesheet" href="/static/assets/css/request.css">
  <link rel="stylesheet" href="/static/assets/css/address-autocomplete.css">
{% endblock %}

{% block main %}

<main class="request-page">
  <section class="request-top">
    <a href="/" class="request-logo" aria-label="Retour à l'accueil">
      <img src="/static/assets/images/logo2.png" alt="Logo Réseau LSF">
    </a>

    <h1>Faire une demande</h1>
  </section>

  <section class="request-section">
    <div class="request-container">

      <div class="request-card">
        <div class="request-photo">
          <img src="{{ interpreter.photo ?? '/static/assets/images/avatar.png' }}" alt="Photo interprète">
        </div>

        <h2>{{ interpreter.firstName }} {{ interpreter.lastName }}</h2>

        <p>{{ interpreter.description ?? "Aucune présentation disponible." }}</p>
        <p><strong>Ville :</strong> {{ interpreter.address.city ?? "Non renseignée" }}</p>
        <p><strong>Email :</strong> {{ interpreter.mail }}</p>
        <p><strong>Téléphone :</strong> {{ interpreter.phone ?? "Non renseigné" }}</p>
      </div>

      <form class="request-form" action="/request/{{ interpreter.id_user }}" method="post">

        <h2 class="request-form-title">Détails de la demande</h2>

        {% if success %}
          <p class="success-message">{{ success }}</p>
        {% endif %}

        {% if error %}
          <p class="error-message">{{ error }}</p>
        {% endif %}

        <label for="clientFirstName">Votre prénom</label>
        <input id="clientFirstName" type="text" name="clientFirstName" value="{{ search.clientFirstName ?? '' }}">

        <label for="clientLastName">Votre nom</label>
        <input id="clientLastName" type="text" name="clientLastName" value="{{ search.clientLastName ?? '' }}">

        <label for="clientEmail">Votre email</label>
        <input id="clientEmail" type="email" name="clientEmail" value="{{ search.clientEmail ?? '' }}">

        <label for="clientPhone">Votre téléphone</label>
        <input id="clientPhone" type="text" name="clientPhone" value="{{ search.clientPhone ?? '' }}">

        <label for="meetingAddress">Lieu</label>
        <input id="meetingAddress" type="text" name="meetingAddress" value="{{ search.meetingAddress ?? '' }}" data-address-autocomplete>

        <label for="date">Date</label>
        <input id="date" type="date" name="date" value="{{ search.date ?? '' }}">

        <label for="startTime">Heure début</label>
        <input id="startTime" type="time" name="startTime" value="{{ search.startTime ?? '' }}">

        <label for="endTime">Heure fin</label>
        <input id="endTime" type="time" name="endTime" value="{{ search.endTime ?? '' }}">

        <label for="interventionType">Type d'intervention</label>
        <input id="interventionType" type="text" name="interventionType" value="{{ search.interventionType ?? '' }}" placeholder="Réunion, rendez-vous médical, formation...">

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" placeholder="Décrivez votre besoin">{{ search.message ?? '' }}</textarea>

        <button type="submit">Envoyer la demande</button>
      </form>

    </div>
  </section>
</main>

<script src="/static/assets/js/addressAutocomplete.js"></script>
{% endblock %}
