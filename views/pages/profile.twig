{% extends "../layout/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/static/assets/css/profile.css">
{% endblock %}

{% block main %}

<main class="profile-page">

  <section class="profile-top">

    <a href="/" class="profile-logo">
      <img src="/static/assets/images/logo2.png" alt="Logo Réseau LSF">
    </a>

    <h1>Mon Profil</h1>

  </section>

  <section class="profile-section">

    <div class="profile-container">

      <div class="profile-left">

        <img src="/static/assets/images/avatar.png" alt="Avatar interprète">

        <p>
          Description de l’interprète : parcours, origine, spécialités...
        </p>

      </div>

      <!-- Colonne droite -->
      <form class="profile-form">

        <div class="form-row">

          <div class="form-group">
            <label>Nom</label>
            <input type="text">
          </div>

          <div class="form-group">
            <label>Prénom</label>
            <input type="text">
          </div>

        </div>

        <div class="form-group">
          <label>Adresse</label>
          <input type="text">
        </div>

        <div class="form-row">

          <div class="form-group">
            <label>Code Postal</label>
            <input type="text">
          </div>

          <div class="form-group">
            <label>Ville</label>
            <input type="text">
          </div>

        </div>

        <div class="form-group">
          <label>Téléphone</label>
          <input type="text">
        </div>

        <div class="form-group">
          <label>Email</label>
          <input type="text">
        </div>

        <button class="profile-btn">
          Enregistrer
        </button>

      </form>

    </div>

  </section>

</main>

{% endblock %}